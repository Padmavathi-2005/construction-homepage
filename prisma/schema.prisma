datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model HeroSequence {
  id          String      @id @default(cuid())
  name        String      @default("Main Hero Sequence")
  isPublished Boolean     @default(false)
  version     Int         @default(1)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  stages      HeroStage[]
}

model HeroStage {
  id            String        @id @default(cuid())
  sequenceId    String
  sequence      HeroSequence  @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order         Int
  title         String
  subtitle      String?
  description   String?
  mediaType     String        @default("image") // "image" | "gif" | "video"
  mediaUrl      String
  thumbnailUrl  String?
  mediaAssetId  String?
  mediaAsset    MediaAsset?   @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  startProgress Float         @default(0.0)
  endProgress   Float         @default(0.1)
  animationMode String        @default("crossfade") // "hold" | "fade" | "crossfade" | "scrub" | "video-scrub"
  duration      Float         @default(1.0)
  enabled       Boolean       @default(true)
  continuityRef String?       // e.g. "Same camera, same building, same horizon"
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([sequenceId, order])
}

model MediaAsset {
  id           String      @id @default(cuid())
  filename     String
  storagePath  String
  publicUrl    String
  mediaType    String      // "image" | "gif" | "video"
  mimeType     String
  width        Int?
  height       Int?
  size         Int         // bytes
  thumbnailUrl String?
  createdAt    DateTime    @default(now())
  stages       HeroStage[]
}

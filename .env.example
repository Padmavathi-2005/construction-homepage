# ========================================================
# AMOGHA DEVELOPERS - HERO CMS CONFIGURATION
# ========================================================

# PostgreSQL Database URL (Supabase, Neon, RDS, or local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amogha_construction?schema=public"

# Supabase Storage (Server-side privileged access)
# Note: Keep the service-role key secret, never expose to the browser!
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="amogha-hero-media"

# Admin Authentication
ADMIN_JWT_SECRET="amogha-secret-jwt-key-2026-production-ready"
ADMIN_DEFAULT_EMAIL="admin@amoghadevelopers.com"
ADMIN_DEFAULT_PASSWORD="AmoghaAdmin2026!"

# Server Port (Default is 8003)
PORT=8003
